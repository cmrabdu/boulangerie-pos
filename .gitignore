/boulangerie-pos
/dist/

# Secrets : ce dépôt est public. Aucune clé ne doit pouvoir y atterrir.
*.env
.env*
# …sauf le modèle, qui ne contient que des noms de variables et des exemples.
!.env.example

# Images générées : lourdes, propres à chaque boulangerie, et reproductibles
# par scripts/generer-images.sh. Le dépôt reste léger.
/img/products/*
!/img/products/.gitkeep
/img/essais/
*.db
*.db-shm
*.db-wal

# Le catalogue réel de la boulangerie n'a rien à faire dans un dépôt public.
/catalogue.csv
.DS_Store
